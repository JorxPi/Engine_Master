# -----------------------------
# Third-party sources you may vendor (keep these)
# -----------------------------
!**/imgui.h
!**/imgui*.cpp
!**/backends/imgui_impl_*.cpp
!**/backends/imgui_impl_*.h
!**/imstb_*.h

# If you vendor DirectXTex shaders, keep sources but ignore compiled
Source/3rdParty/DirectXTex/Shaders/Compiled/
!Source/3rdParty/DirectXTex/Shaders/*.hlsl
!Source/3rdParty/DirectXTex/Shaders/*.h

# -----------------------------
# Game assets & PIX runtime
# -----------------------------
# Track the Game folder and everything inside…
!Game/
!Game/**

# …but still ignore binaries inside Game/
Game/**/*.exe
Game/**/*.dll
Game/**/*.lib
Game/**/*.pdb

# Exception: keep the PIX runtime DLL tracked
!Game/WinPixEventRuntime.dll

