# -----------------------------
# Engine-specific assets
# -----------------------------
# Don’t track compiled shaders, binaries, or Visual Studio auto-generated folders.
# Do track your actual source code, headers, shaders, and ImGui source files.
!**/imgui.h
!**/imgui*.cpp
!**/backends/imgui_impl_*.cpp
!**/backends/imgui_impl_*.h
!**/imstb_*.h

# Ignore build/output folders
x64/
Debug/
Release/
.vs/

# Ignore compiled shaders and binaries
*.cso
*.exe
*.dll
*.pdb
*.lib
*.tlog
*.cache
*.obj

# Ignore intermediate DirectXTex compiled assets
Source/3rdParty/DirectXTex/Shaders/Compiled/

# Keep source shader files
!Source/3rdParty/DirectXTex/Shaders/*.hlsl
!Source/3rdParty/DirectXTex/Shaders/*.h
